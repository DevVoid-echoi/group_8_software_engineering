# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Lấy thông tin DB trên Supabase: Project > Connect > Session pooler.
POSTGRES_USER=postgres.<ma-project>
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432

# Chuỗi ngẫu nhiên để ký JWT. Tạo bằng lệnh:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# (Không bắt buộc) Địa chỉ frontend được phép gọi API. Mặc định là cổng 5500.
# CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
